{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigolmiranda/agent-skills/blob/test/skills/interchange/references/final-response.schema.json",
  "title": "Interchange final assistant response",
  "type": "object",
  "required": ["packet_id", "attempt_id", "result", "summary", "evidence"],
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "result": {
      "enum": ["ready_for_review", "blocked", "partial"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      }
    }
  },
  "additionalProperties": true
}
